{
  "id": "disk-monitor",
  "name": "Monitoreo de Almacenamiento",
  "version": "1.0.0",
  "description": "Telemetría y salud de discos en tiempo real, detección de tecnologías (HDD, SSD, NVMe), auditoría de sectores y selección de unidades vigiladas.",
  "author": "Core Engine",
  "group": "Almacenamiento",
  "entrypoint": "module.js",
  "permissions": [
    "system:storage"
  ],
  "dependencies": [],
  "provides_services": [
    "storage.telemetry"
  ],
  "meta_options": [
    {
      "id": "auto_refresh",
      "name": "Actualización Automática de Telemetría",
      "desc": "Consultar periódicamente el estado y salud de las unidades de almacenamiento.",
      "type": "switch",
      "default": true
    },
    {
      "id": "refresh_interval",
      "name": "Frecuencia de Muestreo",
      "desc": "Intervalo de sondeo en segundo plano para actualizar métricas de salud.",
      "type": "select",
      "default": "30s",
      "options": [
        { "label": "15 Segundos", "value": "15s" },
        { "label": "30 Segundos", "value": "30s" },
        { "label": "1 Minuto", "value": "60s" },
        { "label": "5 Minutos", "value": "300s" },
        { "label": "Manual", "value": "manual" }
      ]
    },
    {
      "id": "notify_health_change",
      "name": "Notificaciones de Salud",
      "desc": "Emitir aviso en el sistema si el estado operativo o SMART de algún disco cambia.",
      "type": "switch",
      "default": true
    },
    {
      "id": "alert_bad_sectors",
      "name": "Alerta Inmediata ante Sectores Dañados",
      "desc": "Notificar inmediatamente si se registran bloques defectuosos o inconsistencias de archivo en Windows.",
      "type": "switch",
      "default": true
    },
    {
      "id": "highlight_system_drive",
      "name": "Distinguir Unidad del Sistema Operativo",
      "desc": "Resaltar con una insignia especial la unidad física que alberga la partición de Windows (C:).",
      "type": "switch",
      "default": true
    }
  ],
  "widgets": [],
  "views": [
    {
      "id": "view-module-disk-monitor",
      "name": "Monitoreo de Almacenamiento",
      "icon": "<svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><path d=\"M22 12H2\"></path><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"></path><line x1=\"6\" y1=\"16\" x2=\"6.01\" y2=\"16\"></line><line x1=\"10\" y1=\"16\" x2=\"10.01\" y2=\"16\"></line></svg>",
      "html": "      <div class=\"disk-monitor-container\" style=\"display: flex; flex-direction: column; gap: 16px; width: 100%; height: 100%; box-sizing: border-box; overflow-y: auto; padding-bottom: 24px;\">        <!-- 1. Barra de Herramientas y Acceso a Configuración -->        <div style=\"display: flex; justify-content: space-between; align-items: center; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 12px 18px; box-shadow: var(--shadow-sm); flex-wrap: wrap; gap: 12px;\">          <div style=\"display: flex; align-items: center; gap: 12px;\">            <div style=\"width: 36px; height: 36px; border-radius: 8px; background: var(--accent-primary-dim); color: var(--accent-primary); display: flex; align-items: center; justify-content: center;\">              <svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><path d=\"M22 12H2\"></path><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"></path><line x1=\"6\" y1=\"16\" x2=\"6.01\" y2=\"16\"></line><line x1=\"10\" y1=\"16\" x2=\"10.01\" y2=\"16\"></line></svg>            </div>            <div>              <div style=\"font-size: 14px; font-weight: 700; color: var(--text-primary);\">Telemetría de Almacenamiento Local</div>              <div style=\"font-size: 11.5px; color: var(--text-muted);\" id=\"dm-last-scan-time\">Última consulta: Pendiente</div>            </div>          </div>          <div style=\"display: flex; align-items: center; gap: 10px;\">            <button class=\"btn btn-secondary\" id=\"btn-dm-refresh\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.scanDisks()\" title=\"Actualizar telemetría de hardware\">              <svg class=\"svg-icon svg-icon-sm\" id=\"icon-dm-spin\" viewBox=\"0 0 24 24\"><polyline points=\"23 4 23 10 17 10\"></polyline><polyline points=\"1 20 1 14 7 14\"></polyline><path d=\"M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15\"></path></svg>              <span>Escanear Ahora</span>            </button>            <button class=\"btn btn-secondary\" onclick=\"switchView('settings'); switchSettingsTab('mod-disk-monitor');\" title=\"Configuración del módulo\">              <svg class=\"svg-icon svg-icon-sm\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"></path></svg>              <span>Configuración</span>            </button>          </div>        </div>        <!-- 2. Tarjetas de Resumen Ejecutivo -->        <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px;\">          <div class=\"settings-card\" style=\"padding: 14px 16px; gap: 4px;\">            <div style=\"font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;\">Discos Detectados</div>            <div style=\"font-size: 22px; font-weight: 800; color: var(--text-primary);\" id=\"dm-stat-total\">-</div>            <div style=\"font-size: 11px; color: var(--text-secondary);\" id=\"dm-stat-tech-breakdown\">Detectando medios...</div>          </div>          <div class=\"settings-card\" style=\"padding: 14px 16px; gap: 4px;\">            <div style=\"font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;\">Discos Vigilados</div>            <div style=\"font-size: 22px; font-weight: 800; color: var(--accent-primary);\" id=\"dm-stat-watched\">-</div>            <div style=\"font-size: 11px; color: var(--text-secondary);\">Unidades con monitoreo activo</div>          </div>          <div class=\"settings-card\" style=\"padding: 14px 16px; gap: 4px;\">            <div style=\"font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;\">Salud General</div>            <div style=\"display: flex; align-items: center; gap: 8px;\">              <div style=\"font-size: 22px; font-weight: 800; color: var(--accent-success);\" id=\"dm-stat-health\">Saludable</div>              <span class=\"card-badge\" style=\"color: var(--accent-success); background: rgba(34, 197, 94, 0.12);\" id=\"dm-stat-health-badge\">OK</span>            </div>            <div style=\"font-size: 11px; color: var(--text-secondary);\" id=\"dm-stat-health-detail\">Cero anomalías críticas detectadas</div>          </div>          <div class=\"settings-card\" style=\"padding: 14px 16px; gap: 4px;\">            <div style=\"font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;\">Capacidad Total</div>            <div style=\"font-size: 22px; font-weight: 800; color: var(--text-primary);\" id=\"dm-stat-capacity\">-</div>            <div style=\"font-size: 11px; color: var(--text-secondary);\" id=\"dm-stat-free-space\">-</div>          </div>        </div>        <!-- 3. Píldoras de Filtrado -->        <div style=\"display: flex; align-items: center; gap: 8px; flex-wrap: wrap;\">          <span style=\"font-size: 12px; font-weight: 600; color: var(--text-muted); margin-right: 4px;\">Filtrar:</span>          <button class=\"btn btn-secondary active\" style=\"padding: 5px 12px; font-size: 12px; border-radius: var(--radius-full);\" id=\"dm-filter-all\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.setFilter('all')\">Todos</button>          <button class=\"btn btn-secondary\" style=\"padding: 5px 12px; font-size: 12px; border-radius: var(--radius-full);\" id=\"dm-filter-watched\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.setFilter('watched')\">Vigilados</button>          <button class=\"btn btn-secondary\" style=\"padding: 5px 12px; font-size: 12px; border-radius: var(--radius-full);\" id=\"dm-filter-nvme\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.setFilter('nvme')\">NVMe</button>          <button class=\"btn btn-secondary\" style=\"padding: 5px 12px; font-size: 12px; border-radius: var(--radius-full);\" id=\"dm-filter-ssd\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.setFilter('ssd')\">SATA SSD</button>          <button class=\"btn btn-secondary\" style=\"padding: 5px 12px; font-size: 12px; border-radius: var(--radius-full);\" id=\"dm-filter-hdd\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.setFilter('hdd')\">HDD Mecánico</button>          <button class=\"btn btn-secondary\" style=\"padding: 5px 12px; font-size: 12px; border-radius: var(--radius-full);\" id=\"dm-filter-alerts\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.setFilter('alerts')\">Alertas (0)</button>        </div>        <!-- 4. Lista Dinámica de Tarjetas de Disco -->        <div id=\"dm-disk-cards-list\" style=\"display: flex; flex-direction: column; gap: 14px;\">          <div class=\"settings-card\" style=\"padding: 24px; text-align: center; color: var(--text-muted);\">            Consultando subsistema de almacenamiento del sistema operativo...          </div>        </div>        <!-- 5. Modal / Panel Flotante de Auditoría de Sectores (Dry-Run) -->        <div id=\"dm-audit-modal\" style=\"display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;\">          <div class=\"settings-card\" style=\"max-width: 540px; width: 100%; padding: 22px; box-shadow: var(--shadow-lg); border: 1px solid var(--border-subtle); gap: 16px;\">            <div style=\"display: flex; justify-content: space-between; align-items: center;\">              <div style=\"display: flex; align-items: center; gap: 10px;\">                <div style=\"width: 32px; height: 32px; border-radius: 8px; background: rgba(59, 130, 246, 0.15); color: #3b82f6; display: flex; align-items: center; justify-content: center;\">                  <svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><polyline points=\"12 6 12 12 14 14\"></polyline></svg>                </div>                <h4 style=\"font-size: 15px; font-weight: 700; margin: 0;\" id=\"dm-audit-title\">Auditoría de Sectores (Modo Seguro Dry-Run)</h4>              </div>              <button class=\"btn-icon\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.closeAuditModal()\" title=\"Cerrar\">&times;</button>            </div>            <p style=\"font-size: 12.5px; color: var(--text-secondary); line-height: 1.5; margin: 0;\">              Esta rutina ejecuta una comprobación no destructiva en modo solo lectura de bloques de almacenamiento y consulta la bitácora de controladores de Windows para detectar sectores defectuosos o inconsistencias de archivo.            </p>            <div style=\"background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 14px;\">              <div style=\"display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 6px;\">                <span id=\"dm-audit-status-label\">Iniciando escaneo...</span>                <span id=\"dm-audit-percent\">0%</span>              </div>              <div style=\"width: 100%; height: 8px; background: var(--bg-surface); border-radius: 4px; overflow: hidden;\">                <div id=\"dm-audit-progress-bar\" style=\"width: 0%; height: 100%; background: var(--accent-primary); transition: width 0.2s ease;\"></div>              </div>              <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; font-size: 11.5px; color: var(--text-secondary);\">                <div>Unidad: <strong id=\"dm-audit-target\" style=\"color: var(--text-primary);\">-</strong></div>                <div>Sectores Evaluados: <strong id=\"dm-audit-sectors-count\" style=\"color: var(--text-primary);\">0</strong></div>                <div>Bloques Dañados: <strong id=\"dm-audit-bad-count\" style=\"color: var(--accent-success);\">0</strong></div>                <div>Latencia Media: <strong id=\"dm-audit-latency\" style=\"color: var(--text-primary);\">-</strong></div>              </div>            </div>            <div style=\"display: flex; justify-content: flex-end; gap: 10px;\">              <button class=\"btn btn-secondary\" id=\"btn-dm-audit-cancel\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.cancelAudit()\">Cancelar</button>              <button class=\"btn btn-primary\" id=\"btn-dm-audit-finish\" style=\"display: none;\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.closeAuditModal()\">Completar</button>            </div>          </div>        </div>      </div>"
    }
  ]
}
