{
  "id": "disk-monitor",
  "name": "Monitoreo de Almacenamiento",
  "version": "2.0.0",
  "description": "Supervisión técnica en tiempo real de unidades físicas locales y extraíbles (NVMe, SSD, HDD, USB), particiones, salud SMART y telemetría de capacidad.",
  "author": "White-Label Modular",
  "group": "General",
  "entrypoint": "module.js",
  "permissions": [
    "system:storage",
    "system:execute"
  ],
  "requires_service": false,
  "service_reason": "Consume telemetría física SMART y porcentaje de salud a través del servicio central de telemetría de Windows.",
  "background_worker": {
    "id": "disk_smart_collector",
    "name": "Colector SMART y Salud de Discos",
    "frequency": "Cada 6s",
    "script": "collector.ps1",
    "run_prelogon": true
  },
  "dependencies": [],
  "provides_services": [
    "storage.telemetry"
  ],
  "meta_options": [
    {
      "id": "auto_refresh",
      "name": "Actualización Automática de Telemetría",
      "desc": "Consultar periódicamente el estado y salud de las unidades del sistema.",
      "type": "switch",
      "default": true
    },
    {
      "id": "refresh_interval",
      "name": "Frecuencia de Muestreo",
      "desc": "Intervalo de sondeo en segundo plano para actualizar métricas operativas.",
      "type": "select",
      "default": "30s",
      "options": [
        { "label": "15 Segundos", "value": "15s" },
        { "label": "30 Segundos", "value": "30s" },
        { "label": "1 Minuto", "value": "60s" },
        { "label": "5 Minutos", "value": "300s" },
        { "label": "Manual", "value": "manual" }
      ]
    },
    {
      "id": "include_usb",
      "name": "Supervisar Unidades USB / Extraíbles",
      "desc": "Detectar e incorporar dispositivos de almacenamiento USB y memorias extraíbles en la lista operativa.",
      "type": "switch",
      "default": true
    },
    {
      "id": "notify_health_change",
      "name": "Notificaciones de Anomalías de Salud",
      "desc": "Emitir aviso en el sistema si el estado operativo de algún disco entra en alerta o degradación.",
      "type": "switch",
      "default": true
    }
  ],
  "widgets": [
    {
      "id": "card-disk-overview",
      "name": "Almacenamiento General",
      "size": "2x1",
      "orientation": "universal",
      "html": "<header class=\"card-header\"><div class=\"card-title-box\"><div class=\"card-icon-wrap\"><svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><path d=\"M22 12H2\"></path><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"></path><line x1=\"6\" y1=\"16\" x2=\"6.01\" y2=\"16\"></line><line x1=\"10\" y1=\"16\" x2=\"10.01\" y2=\"16\"></line></svg></div><h4>Almacenamiento</h4></div><span class=\"card-badge\" id=\"dm-w-disks-count\">-- Discos</span></header><div class=\"card-body\" style=\"display: flex; flex-direction: column; justify-content: center; gap: 8px;\"><div style=\"display: flex; justify-content: space-between; align-items: baseline;\"><span style=\"font-size: 11.5px; color: var(--text-secondary);\">Espacio Usado</span><span style=\"font-size: 13px; font-weight: 700; color: var(--text-primary);\" id=\"dm-w-used-text\">-- / --</span></div><div style=\"width: 100%; height: 8px; border-radius: 4px; background: var(--bg-surface); overflow: hidden; border: 1px solid var(--border-subtle);\"><div id=\"dm-w-used-bar\" style=\"height: 100%; width: 0%; border-radius: 4px; background: var(--accent-primary); transition: width 0.4s ease;\"></div></div><div style=\"display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted);\"><span id=\"dm-w-free-text\">Disponible: --</span><span id=\"dm-w-health-badge\" style=\"color: #10b981;\">Salud: OK</span></div></div>"
    },
    {
      "id": "card-disk-drive-c",
      "name": "Unidad del Sistema (C:)",
      "size": "2x1",
      "orientation": "universal",
      "html": "<header class=\"card-header\"><div class=\"card-title-box\"><div class=\"card-icon-wrap\"><svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\"></rect><path d=\"M7 7h10\"></path><path d=\"M7 12h10\"></path><path d=\"M7 17h10\"></path></svg></div><h4>Unidad (C:)</h4></div><span class=\"card-badge\" id=\"dm-w-c-type\">Sistema</span></header><div class=\"card-body\" style=\"display: flex; flex-direction: column; justify-content: center; gap: 8px;\"><div style=\"display: flex; justify-content: space-between; align-items: baseline;\"><span style=\"font-size: 11.5px; color: var(--text-secondary);\" id=\"dm-w-c-label\">C: (NTFS)</span><span style=\"font-size: 13px; font-weight: 700; color: var(--text-primary);\" id=\"dm-w-c-pct\">--%</span></div><div style=\"width: 100%; height: 8px; border-radius: 4px; background: var(--bg-surface); overflow: hidden; border: 1px solid var(--border-subtle);\"><div id=\"dm-w-c-bar\" style=\"height: 100%; width: 0%; border-radius: 4px; background: var(--accent-primary); transition: width 0.4s ease;\"></div></div><div style=\"display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted);\"><span id=\"dm-w-c-space\">-- libre de --</span><span id=\"dm-w-c-temp\" style=\"color: #06b6d4;\">-- °C</span></div></div>"
    }
  ],
  "views": [
    {
      "id": "view-module-disk-monitor",
      "name": "Monitoreo de Almacenamiento",
      "icon": "<svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><path d=\"M22 12H2\"></path><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"></path><line x1=\"6\" y1=\"16\" x2=\"6.01\" y2=\"16\"></line><line x1=\"10\" y1=\"16\" x2=\"10.01\" y2=\"16\"></line></svg>",
      "html": "<div class=\"disk-monitor-container\" style=\"display: flex; flex-direction: column; gap: 16px; width: 100%; height: 100%; box-sizing: border-box; overflow-y: auto; padding-bottom: 24px;\"><div style=\"display: flex; justify-content: space-between; align-items: center; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 12px 18px; box-shadow: var(--shadow-sm); flex-wrap: wrap; gap: 12px;\"><div style=\"display: flex; align-items: center; gap: 12px;\"><div style=\"width: 36px; height: 36px; border-radius: 8px; background: var(--accent-primary-dim); color: var(--accent-primary); display: flex; align-items: center; justify-content: center;\"><svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><path d=\"M22 12H2\"></path><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"></path><line x1=\"6\" y1=\"16\" x2=\"6.01\" y2=\"16\"></line><line x1=\"10\" y1=\"16\" x2=\"10.01\" y2=\"16\"></line></svg></div><div><div style=\"font-size: 14px; font-weight: 700; color: var(--text-primary);\">Monitoreo de Almacenamiento</div><div style=\"font-size: 11.5px; color: var(--text-muted);\" id=\"dm-last-scan-time\">Descubrimiento automático en curso...</div></div></div><div style=\"display: flex; align-items: center; gap: 10px;\"><div id=\"dm-filter-chips\" style=\"display: flex; gap: 6px; flex-wrap: wrap;\"><button class=\"btn btn-sm btn-primary\" data-filter=\"all\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.setFilter('all')\">Todos</button><button class=\"btn btn-sm btn-secondary\" data-filter=\"nvme\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.setFilter('nvme')\">NVMe</button><button class=\"btn btn-sm btn-secondary\" data-filter=\"ssd\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.setFilter('ssd')\">SATA SSD</button><button class=\"btn btn-sm btn-secondary\" data-filter=\"hdd\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.setFilter('hdd')\">HDD</button><button class=\"btn btn-sm btn-secondary\" data-filter=\"usb\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.setFilter('usb')\">USB</button></div><button class=\"btn btn-secondary\" id=\"btn-dm-refresh\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.refreshDisks()\" title=\"Actualizar telemetría de unidades\"><svg class=\"svg-icon svg-icon-sm\" id=\"icon-dm-spin\" viewBox=\"0 0 24 24\"><polyline points=\"23 4 23 10 17 10\"></polyline><polyline points=\"1 20 1 14 7 14\"></polyline><path d=\"M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15\"></path></svg><span>Actualizar</span></button><button class=\"btn btn-secondary\" onclick=\"switchView('settings'); switchSettingsTab('mod-disk-monitor');\" title=\"Configuración de parámetros del módulo\"><svg class=\"svg-icon svg-icon-sm\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"></path></svg><span>Configuración</span></button></div></div><div id=\"dm-main-content-area\"><div style=\"padding: 40px; text-align: center; color: var(--text-muted); display: flex; flex-direction: column; align-items: center; gap: 12px;\"><svg class=\"svg-icon rotating\" style=\"width: 32px; height: 32px;\" viewBox=\"0 0 24 24\"><path d=\"M21 12a9 9 0 1 1-6.219-8.56\"></path></svg><span>Iniciando descubrimiento automático de unidades físicas...</span></div></div><div id=\"dm-audit-modal\" style=\"display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;\"><div class=\"settings-card\" style=\"max-width: 580px; width: 100%; padding: 22px; box-shadow: var(--shadow-lg); border: 1px solid var(--border-subtle); gap: 16px;\"><div style=\"display: flex; justify-content: space-between; align-items: center;\"><div style=\"display: flex; align-items: center; gap: 10px;\"><div style=\"width: 32px; height: 32px; border-radius: 8px; background: rgba(59, 130, 246, 0.15); color: #3b82f6; display: flex; align-items: center; justify-content: center;\"><svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line></svg></div><h4 style=\"font-size: 15px; font-weight: 700; margin: 0;\" id=\"dm-audit-title\">Registro de Eventos de Almacenamiento</h4></div><button class=\"btn-icon\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.closeAuditModal()\" title=\"Cerrar\">&times;</button></div><p style=\"font-size: 12.5px; color: var(--text-secondary); line-height: 1.5; margin: 0;\">Eventos registrados por el subsistema de almacenamiento de Windows (controladores, NTFS, partmgr).</p><div id=\"dm-audit-content-area\" style=\"background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 14px; display: flex; flex-direction: column; gap: 10px; max-height: 320px; overflow-y: auto;\"></div><div style=\"display: flex; justify-content: flex-end; gap: 10px;\"><button class=\"btn btn-primary\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.closeAuditModal()\">Entendido</button></div></div></div></div>"
    }
  ]
}
