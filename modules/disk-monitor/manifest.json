{
  "id": "disk-monitor",
  "name": "Monitoreo de Almacenamiento",
  "version": "1.1.0",
  "description": "Supervisión técnica de unidades físicas locales y dispositivos USB (HDD, SSD, NVMe), telemetría de salud y diagnóstico de integridad.",
  "author": "White-Label Modular",
  "group": "General",
  "entrypoint": "module.js",
  "permissions": [
    "system:storage",
    "system:execute"
  ],
  "requires_service": false,
  "service_reason": "Consume telemetría física SMART y porcentaje de salud a través del servicio central de telemetría de Windows.",
  "background_worker": {
    "id": "disk_smart_collector",
    "name": "Colector SMART y Salud de Discos",
    "frequency": "Cada 6s",
    "script": "collector.ps1",
    "run_prelogon": true
  },
  "dependencies": [],
  "provides_services": [
    "storage.telemetry"
  ],
  "meta_options": [
    {
      "id": "auto_refresh",
      "name": "Actualización Automática de Telemetría",
      "desc": "Consultar periódicamente el estado y salud de las unidades seleccionadas.",
      "type": "switch",
      "default": true
    },
    {
      "id": "refresh_interval",
      "name": "Frecuencia de Muestreo",
      "desc": "Intervalo de sondeo en segundo plano para actualizar métricas operativas.",
      "type": "select",
      "default": "30s",
      "options": [
        { "label": "15 Segundos", "value": "15s" },
        { "label": "30 Segundos", "value": "30s" },
        { "label": "1 Minuto", "value": "60s" },
        { "label": "5 Minutos", "value": "300s" },
        { "label": "Personalizado", "value": "custom" },
        { "label": "Manual", "value": "manual" }
      ]
    },
    {
      "id": "custom_interval_seconds",
      "name": "Tiempo Personalizado de Muestreo (Segundos)",
      "desc": "Establece los segundos entre actualizaciones cuando la frecuencia es 'Personalizado' (mínimo 5s).",
      "type": "number",
      "default": 45,
      "min": 5,
      "max": 86400
    },
    {
      "id": "include_usb",
      "name": "Supervisar Unidades USB / Extraíbles",
      "desc": "Detectar e incorporar dispositivos de almacenamiento USB y memorias extraíbles en la lista de descubrimiento.",
      "type": "switch",
      "default": true
    },
    {
      "id": "notify_health_change",
      "name": "Notificaciones de Anomalías de Salud",
      "desc": "Emitir aviso en el sistema si el estado operativo de algún disco vigilado entra en alerta o degradación.",
      "type": "switch",
      "default": true
    }
  ],
  "widgets": [],
  "views": [
    {
      "id": "view-module-disk-monitor",
      "name": "Monitoreo de Almacenamiento",
      "icon": "<svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><path d=\"M22 12H2\"></path><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"></path><line x1=\"6\" y1=\"16\" x2=\"6.01\" y2=\"16\"></line><line x1=\"10\" y1=\"16\" x2=\"10.01\" y2=\"16\"></line></svg>",
      "html": "      <div class=\"disk-monitor-container\" style=\"display: flex; flex-direction: column; gap: 16px; width: 100%; height: 100%; box-sizing: border-box; overflow-y: auto; padding-bottom: 24px;\">        <!-- 1. Barra de Herramientas Canónica -->        <div style=\"display: flex; justify-content: space-between; align-items: center; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 12px 18px; box-shadow: var(--shadow-sm); flex-wrap: wrap; gap: 12px;\">          <div style=\"display: flex; align-items: center; gap: 12px;\">            <div style=\"width: 36px; height: 36px; border-radius: 8px; background: var(--accent-primary-dim); color: var(--accent-primary); display: flex; align-items: center; justify-content: center;\">              <svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><path d=\"M22 12H2\"></path><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"></path><line x1=\"6\" y1=\"16\" x2=\"6.01\" y2=\"16\"></line><line x1=\"10\" y1=\"16\" x2=\"10.01\" y2=\"16\"></line></svg>            </div>            <div>              <div style=\"font-size: 14px; font-weight: 700; color: var(--text-primary);\">Monitoreo de Almacenamiento</div>              <div style=\"font-size: 11.5px; color: var(--text-muted);\" id=\"dm-last-scan-time\">Listo</div>            </div>          </div>          <div style=\"display: flex; align-items: center; gap: 10px;\">            <button class=\"btn btn-primary\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.openDiscoveryModal()\" title=\"Escanear el bus del sistema y agregar unidades al monitoreo\">              <svg class=\"svg-icon svg-icon-sm\" viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line><line x1=\"11\" y1=\"8\" x2=\"11\" y2=\"14\"></line><line x1=\"8\" y1=\"11\" x2=\"14\" y2=\"11\"></line></svg>              <span>Buscar Discos</span>            </button>            <button class=\"btn btn-secondary\" id=\"btn-dm-refresh\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.refreshWatchedDisks()\" title=\"Actualizar telemetría de unidades vigiladas\">              <svg class=\"svg-icon svg-icon-sm\" id=\"icon-dm-spin\" viewBox=\"0 0 24 24\"><polyline points=\"23 4 23 10 17 10\"></polyline><polyline points=\"1 20 1 14 7 14\"></polyline><path d=\"M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15\"></path></svg>              <span>Actualizar</span>            </button>            <button class=\"btn btn-secondary\" onclick=\"switchView('settings'); switchSettingsTab('mod-disk-monitor');\" title=\"Configuración de parámetros del módulo\">              <svg class=\"svg-icon svg-icon-sm\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"></path></svg>              <span>Configuración</span>            </button>          </div>        </div>        <!-- 2. Contenedor Dinámico Principal (Empty State o Tablero Operativo) -->        <div id=\"dm-main-content-area\"></div>        <!-- 3. Modal de Búsqueda y Descubrimiento de Discos -->        <div id=\"dm-discovery-modal\" style=\"display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;\">          <div class=\"settings-card\" style=\"max-width: 640px; width: 100%; max-height: 85vh; display: flex; flex-direction: column; padding: 20px; box-shadow: var(--shadow-lg); border: 1px solid var(--border-subtle); gap: 14px;\">            <div style=\"display: flex; justify-content: space-between; align-items: center;\">              <div style=\"display: flex; align-items: center; gap: 10px;\">                <div style=\"width: 32px; height: 32px; border-radius: 8px; background: var(--accent-primary-dim); color: var(--accent-primary); display: flex; align-items: center; justify-content: center;\">                  <svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line></svg>                </div>                <h4 style=\"font-size: 15px; font-weight: 700; margin: 0;\">Descubrimiento de Unidades Físicas</h4>              </div>              <button class=\"btn-icon\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.closeDiscoveryModal()\" title=\"Cerrar\">&times;</button>            </div>            <p style=\"font-size: 12.5px; color: var(--text-secondary); margin: 0;\">              A continuación se listan las unidades detectadas en el sistema. Seleccione las unidades que desea incorporar a la vista operativa del módulo.            </p>            <div id=\"dm-discovery-list\" style=\"display: flex; flex-direction: column; gap: 10px; overflow-y: auto; max-height: 380px; padding: 4px;\">              <div style=\"padding: 24px; text-align: center; color: var(--text-muted);\">Escaneando bus de almacenamiento...</div>            </div>            <div style=\"display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-subtle); padding-top: 12px;\">              <span style=\"font-size: 12px; color: var(--text-muted);\" id=\"dm-discovery-summary\">0 unidades seleccionadas</span>              <div style=\"display: flex; gap: 10px;\">                <button class=\"btn btn-secondary\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.closeDiscoveryModal()\">Cancelar</button>                <button class=\"btn btn-primary\" id=\"btn-dm-confirm-add\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.addSelectedDisks()\">Agregar al Monitoreo</button>              </div>            </div>          </div>        </div>        <!-- 4. Modal de Diagnóstico de Integridad Real (Windows Storage Log) -->        <div id=\"dm-audit-modal\" style=\"display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;\">          <div class=\"settings-card\" style=\"max-width: 560px; width: 100%; padding: 22px; box-shadow: var(--shadow-lg); border: 1px solid var(--border-subtle); gap: 16px;\">            <div style=\"display: flex; justify-content: space-between; align-items: center;\">              <div style=\"display: flex; align-items: center; gap: 10px;\">                <div style=\"width: 32px; height: 32px; border-radius: 8px; background: rgba(59, 130, 246, 0.15); color: #3b82f6; display: flex; align-items: center; justify-content: center;\">                  <svg class=\"svg-icon\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line></svg>                </div>                <h4 style=\"font-size: 15px; font-weight: 700; margin: 0;\" id=\"dm-audit-title\">Diagnóstico de Integridad de Bloques</h4>              </div>              <button class=\"btn-icon\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.closeAuditModal()\" title=\"Cerrar\">&times;</button>            </div>            <p style=\"font-size: 12.5px; color: var(--text-secondary); line-height: 1.5; margin: 0;\">              Inspección de anomalías en tiempo real. Consulta eventos del controlador de hardware, NTFS y eventos de bloques defectuosos en el registro del sistema de Windows.            </p>            <div id=\"dm-audit-content-area\" style=\"background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 14px; display: flex; flex-direction: column; gap: 10px;\">              <!-- Contenido dinámico del diagnóstico real -->            </div>            <div style=\"display: flex; justify-content: flex-end; gap: 10px;\">              <button class=\"btn btn-primary\" onclick=\"window.__DISK_MONITOR__ && window.__DISK_MONITOR__.closeAuditModal()\">Entendido</button>            </div>          </div>        </div>      </div>"
    }
  ]
}
